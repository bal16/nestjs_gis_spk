{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^(\\.\\.?\\/.+)\\.js$": "$1"
  },
  "reporters": [
    "default",
    [
      "<rootDir>/markdown-reporter.js",
      {
        "outputPath": "./test/results/e2e.test_report.md"
      }
    ]
  ]
}
