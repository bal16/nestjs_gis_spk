# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL connection string for Prisma (Required).
# For NeonDB / Supabase connection pooling, use the pooled URL (e.g. contains '-pooler' and '?sslmode=require').
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"

# Direct connection string for Prisma CLI migrations (Optional in local dev, Required for NeonDB).
# NeonDB PgBouncer/transaction poolers do not support advisory locks used during migration.
# Defaults to DATABASE_URL if omitted.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"

# ==============================================================================
# SERVER & NETWORK (Optional)
# ==============================================================================
# Port for the HTTP server to listen on.
# Optional. Default: 3000 (Set to 3001 in local dev to avoid port collision with Next.js frontend).
PORT=3001

# Allowed origins for Cross-Origin Resource Sharing (CORS).
# Optional. Default: "http://localhost:3000"
# Multiple origins can be comma-separated (e.g. "https://app.ft.unnes.ac.id,http://localhost:3000").
CORS_ORIGIN="http://localhost:3000"

# ==============================================================================
# JWT AUTHENTICATION SECRETS (Required)
# ==============================================================================
# Secret key used to sign access tokens (short-lived).
JWT_SECRET="your-jwt-access-token-secret-key-change-in-production"

# Secret key used to sign refresh tokens (7-day validity).
JWT_REFRESH_SECRET="your-jwt-refresh-token-secret-key-change-in-production"

# ==============================================================================
# ENVIRONMENT MODE (Optional)
# ==============================================================================
# Runtime environment: development | production | test
# Optional. Default: "development"
NODE_ENV="development"
