// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(cuid())
  name     String  @unique
  email    String  @unique
  password String
  avatar   String? @db.Text
  isAdmin  Boolean @default(false)
  token    String?
}

model Building {
  id       String    @id @default(cuid())
  code     String    @unique
  name     String    @db.Char(20)
  location Location?
  criteria Criteria?
}

model Location {
  building_id String   @id
  building    Building @relation(fields: [building_id], references: [id])
  longitude   Float    @db.DoublePrecision
  latitude    Float    @db.DoublePrecision
}

model Criteria {
  building_id String   @id
  building    Building @relation(fields: [building_id], references: [id], onDelete: Cascade)
  age         Int      @db.Integer

  structure_id   Int?
  arsitecture_id Int?
  mep_id         Int?
  utility_id     Int?
  damage_id      Int?

  structure   Ref_Condition? @relation("StructureRelation", fields: [structure_id], references: [id], onDelete: SetNull)
  arsitecture Ref_Condition? @relation("ArsitectureRelation", fields: [arsitecture_id], references: [id], onDelete: SetNull)
  mep         Ref_Condition? @relation("MepRelation", fields: [mep_id], references: [id], onDelete: SetNull)
  utility     Ref_Level?     @relation("UtilityRelation", fields: [utility_id], references: [id], onDelete: SetNull)
  damage      Ref_Level?     @relation("DamageRelation", fields: [damage_id], references: [id], onDelete: SetNull)
}

model Ref_Condition {
  id   Int    @id @default(autoincrement())
  name String @unique @db.Char(30)

  structures   Criteria[] @relation("StructureRelation")
  arsitectures Criteria[] @relation("ArsitectureRelation")
  meps         Criteria[] @relation("MepRelation")
}

model Ref_Level {
  id   Int    @id @default(autoincrement())
  name String @unique @db.Char(30)

  utilities Criteria[] @relation("UtilityRelation")
  damages   Criteria[] @relation("DamageRelation")
}
