// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  name     String  @unique
  email    String  @unique
  password String
  isAdmin  Boolean @default(false)
  token    String?
}

model Building {
  id        String @id @default(cuid())
  code      String @unique
  name      String @db.Char(20)
  latitude  Float
  longitude Float
  score     Float?
  priority  Int?

  assessments   Assessment?
  sawRunDetails SawRunDetail[]
}

model Assessment {
  id           String @id @default(cuid())
  buildingId   String @unique
  age          Int
  structure    Int
  architecture Int
  mep          Int
  utility      Int
  damage       Int

  building Building @relation(fields: [buildingId], references: [id])
}

model SawRun {
  id             String         @id @default(cuid())
  date           DateTime
  averageScore   Float?
  totalBuildings Int?
  sawRunDetails  SawRunDetail[]
}

model SawRunDetail {
  id         String @id @default(cuid())
  sawRunId   String
  buildingId String
  score      Float
  priority   Int
  // detail     String?

  sawRun   SawRun   @relation(fields: [sawRunId], references: [id])
  building Building @relation(fields: [buildingId], references: [id])
}
